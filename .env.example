# ---- Copia este archivo como .env y rellena tus datos ----

# Puerto y URL pública del sitio (usa https en producción)
PORT=3000
BASE_URL=http://localhost:3000

# ---- Administrador ----
ADMIN_USER=admin
ADMIN_PASS=cambia-esta-contraseña
# Secreto para firmar la sesión del admin (cualquier texto largo y aleatorio)
SESSION_SECRET=pon-aqui-un-texto-largo-aleatorio

# ---- Correo de la barbería (a dónde llegan los avisos de cita) ----
BARBERIA_EMAIL=labarberia@gmail.com

# ---- SMTP para enviar correos ----
# Para Gmail: crea una "Contraseña de aplicación" (no tu contraseña normal)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion
MAIL_FROM="Tata Barber <tucorreo@gmail.com>"

# ---- Mercado Pago (pagos reales). Si lo dejas vacío, funciona en MODO DEMO ----
# Consigue tu Access Token en:
# https://www.mercadopago.com.mx/developers/panel/app  → tu aplicación → Credenciales
# - Para PROBAR usa el token de prueba (empieza con TEST-...)
# - Para COBRAR de verdad usa el token de producción (empieza con APP_USR-...)
MP_ACCESS_TOKEN=
